{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "lineWidth": 120,
  "indentWidth": 2,
  "useTabs": false,
  "newLineKind": "lf",
  "excludes": [
    "**/node_modules",
    "**/*-lock.json",
    ".boilerplate-answers.yaml",
    ".updatecli/manifests/**",
    "templates/*/fragments/**",
    "templates/*/.dprint/**",
    "templates/*/.mise/conf.d/**",
    "templates/*/.updatecli/manifests/**",
    "templates/base/_partials/**",
    "templates/base/.biome.json",
    "templates/base/.codebook.toml",
    "templates/base/.devcontainer/devcontainer.json",
    "templates/base/.dprint.json",
    "templates/base/.github/actions/setup/action.yml",
    "templates/base/.github/workflows/pr.yaml",
    "templates/base/.github/workflows/release.yaml",
    "templates/base/.github/workflows/update-deps.yaml",
    "templates/base/.gitignore",
    "templates/base/.ryl.toml",
    "templates/base/.updatecli/values.yaml",
    "templates/base/README.md",
    "templates/base/REUSE.toml",
    "templates/base/cog.toml",
    "templates/base/prek.toml",
    "templates/container/.github/workflows/release-container.yaml",
    "templates/container/.mise/tasks/container/build.sh",
    "templates/container/.mise/tasks/container/publish.sh",
    "templates/container/.mise/tasks/container/security-scan.sh",
    "templates/helmcharts/.mise/tasks/helmcharts/install-plugins.sh",
    "templates/hugo/src/go.mod",
    "templates/hugo/src/hugo.yaml",
    "templates/hugo/src/layouts/home.html",
    "templates/hugo/tests/package.json",
    "templates/python/pyproject.toml",
    "templates/rust/.rustfmt.toml",
    "templates/rust/Cargo.toml",
    "CHANGELOG.md"
  ],
  "extends": [
    ".dprint/base.json"
  ]
}
