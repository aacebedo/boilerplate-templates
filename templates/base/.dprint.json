{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "lineWidth": 120,
  "indentWidth": 2,
  "useTabs": false,
  "newLineKind": "lf",
  "excludes": [
    "**/node_modules",
    "**/*-lock.json",
    ".boilerplate-answers.yaml",
    ".updatecli/manifests/**",
    "CHANGELOG.md"
  ],
  "extends": [
{{ shell "sh" (printf "%s/_partials/static-files.sh" templateFolder) (env "PWD" "") .layers "dprint" | trim | indent 4 }}
  ]
}
